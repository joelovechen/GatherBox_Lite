{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GatherBoxLite",
  "mainBinaryName": "GatherBoxLite",
  "version": "0.2.0",
  "identifier": "com.gatherbox.lite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GatherBox",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "devtools": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/MicrosoftEdgeWebview2Setup.exe"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
